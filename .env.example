# Copy to .env and fill in from your Firebase project settings (Project Settings > General > Your apps > SDK setup).
# These are safe to expose in a client bundle — Firestore security is enforced by firestore.rules, not by hiding this config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: https://api-ninjas.com quote-of-the-day key. Exposed in the client bundle by necessity
# (see TODO.md "API key exposure" note) — only used for the cache-first daily quote fetch.
VITE_API_NINJAS_KEY=
